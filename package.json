{
  "name": "screeps-bot",
  "version": "0.1.0",
  "description": "Screeps AI, written in TypeScript.",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "deploy": "npm run build && node scripts/deploy.mjs",
    "watch": "vite build --watch",
    "lint": "eslint src --ext .ts"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.0",
    "@types/node": "^20.0.0",
    "@types/screeps": "^3.3.0",
    "screeps-api": "^2.1.0",
    "typescript": "^5.5.0",
    "vite": "^8.3.0"
  }
}
